PORT = 4000
NODE_ENV = development
JWT_SECRET = ""
DATABASE_URL = ""

# Public URL of the frontend, used in emails and Stripe redirects
APP_URL = "http://localhost:5173"

# Comma-separated extra CORS origins
CORS_ORIGINS = ""

# Stripe (billing)
STRIPE_SECRET_KEY = ""
STRIPE_WEBHOOK_SECRET = ""
STRIPE_PRO_PRICE_ID = ""

# Cloudflare R2 (file uploads)
R2_ENDPOINT = ""
R2_ACCESS_KEY_ID = ""
R2_SECRET_ACCESS_KEY = ""
R2_BUCKET = ""
R2_PUBLIC_URL = ""

# Resend (transactional email)
RESEND_API_KEY = ""
EMAIL_FROM = "Formium <no-reply@formium.app>"

# Anthropic (AI insights)
ANTHROPIC_API_KEY = ""
ANTHROPIC_MODEL = "claude-sonnet-4-5"

# Sentry (error monitoring)
SENTRY_DSN = ""
